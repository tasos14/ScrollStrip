<Window x:Class="ScrollStrip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScrollStrip Settings" SizeToContent="Height" Width="700"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,4,8,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="DescriptionText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>

        <!-- Touchpad icon: right edge highlighted -->
        <DrawingImage x:Key="IconRightEdge">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F5F5F5">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0.75,0.75,18.5,14.5" RadiusX="2.5" RadiusY="2.5"/>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#A8A8A8" Thickness="1.5"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#C8C8C8">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="15.5,1.75,3,11.5" RadiusX="1.5" RadiusY="1.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Touchpad icon: left edge highlighted -->
        <DrawingImage x:Key="IconLeftEdge">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F5F5F5">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0.75,0.75,18.5,14.5" RadiusX="2.5" RadiusY="2.5"/>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#A8A8A8" Thickness="1.5"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#C8C8C8">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="1.5,1.75,3,11.5" RadiusX="1.5" RadiusY="1.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Touchpad icon: bottom edge highlighted -->
        <DrawingImage x:Key="IconBottomEdge">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F5F5F5">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0.75,0.75,18.5,14.5" RadiusX="2.5" RadiusY="2.5"/>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#A8A8A8" Thickness="1.5"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#C8C8C8">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="1.75,11.75,16.5,2.5" RadiusX="1.5" RadiusY="1.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left column: behaviour -->
        <StackPanel Grid.Column="0">
            <GroupBox Header="General">
                <StackPanel>
                    <CheckBox Content="Enable edge scrolling" IsChecked="{Binding EdgeScrollEnabled}"/>
                    <CheckBox Content="Smooth scrolling (inertia)" IsChecked="{Binding InertiaEnabled}"/>
                    <TextBlock Text="{Binding InertiaStrength, StringFormat='Inertia strength: {0}/10'}" Style="{StaticResource DescriptionText}"/>
                    <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding InertiaStrength}"/>
                    <CheckBox Content="Lock cursor position while scrolling" IsChecked="{Binding LockCursorDuringScroll}"/>
                    <CheckBox Content="Run at Windows startup" IsChecked="{Binding RunAtStartup}"/>
                </StackPanel>
            </GroupBox>

            <!-- Zone geometry and lifecycle, shared by every edge -->
            <GroupBox Header="Edge Zone">
                <StackPanel>
                    <TextBlock Text="{Binding EdgeZoneWidthMm, StringFormat='Zone width: {0:F1} mm'}" Style="{StaticResource DescriptionText}"/>
                    <Slider Minimum="1.5" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            Value="{Binding EdgeZoneWidthMm}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Default (12 mm)" Padding="8,2" Click="OnZonePresetDefault"/>
                        <Button Content="Device edge (1.8 mm)" Padding="8,2" Margin="6,0,0,0" Click="OnZonePresetDeviceEdge"
                                ToolTip="A thin strip right at the rim of the pad, like Scroll.app's device-edge mode"/>
                    </StackPanel>
                    <CheckBox Content="Only scroll if the touch starts in the zone" IsChecked="{Binding RequireBeginInZone}"/>
                    <CheckBox Content="Stop scrolling when the finger leaves the zone" IsChecked="{Binding StopWhenLeavingZone}"/>
                    <TextBlock Style="{StaticResource DescriptionText}" TextWrapping="Wrap"
                               Text="Touchpads that don't report their physical size use a percentage of the pad instead (10% by default)."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Advanced">
                <StackPanel>
                    <CheckBox IsChecked="{Binding SuppressNativeWheel}">
                        <TextBlock Text="Block the touchpad's own wheel events while scrolling" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock Style="{StaticResource DescriptionText}" TextWrapping="Wrap"
                               Text="Only needed if a touchpad driver's own edge scrolling doubles up with ScrollStrip's. Also blocks a mouse wheel while an edge scroll is running."/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Right column: edges and apps -->
        <!-- A grid, not a stack, so the app list can grow to fill the column next to the taller left one. -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Vertical (left and right edges) -->
            <GroupBox Grid.Row="0">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource IconLeftEdge}" Width="20" Height="16" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        <Image Source="{StaticResource IconRightEdge}" Width="20" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Side Edges — Vertical Scroll" Foreground="Black" FontSize="12" Margin="0" VerticalAlignment="Center"/>
                    </StackPanel>
                </GroupBox.Header>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row="0" Grid.Column="0" Content="Right edge" IsChecked="{Binding RightEdgeEnabled}"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="Invert" IsChecked="{Binding InvertVerticalScroll}"/>
                        <CheckBox Grid.Row="1" Grid.Column="0" Content="Left edge" IsChecked="{Binding LeftEdgeEnabled}"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="Invert" IsChecked="{Binding InvertLeftEdgeScroll}"/>
                    </Grid>
                    <TextBlock Text="{Binding VerticalScrollSpeedMultiplier, StringFormat='Scroll speed: {0:F1}×'}" Style="{StaticResource DescriptionText}"/>
                    <Slider Minimum="0.5" Maximum="5.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                            Value="{Binding VerticalScrollSpeedMultiplier}"/>
                </StackPanel>
            </GroupBox>

            <!-- Horizontal (bottom edge) -->
            <GroupBox Grid.Row="1">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource IconBottomEdge}" Width="20" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Bottom Edge — Horizontal Scroll" Foreground="Black" FontSize="12" Margin="0" VerticalAlignment="Center"/>
                    </StackPanel>
                </GroupBox.Header>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Bottom edge" IsChecked="{Binding BottomEdgeEnabled}"/>
                        <CheckBox Grid.Column="1" Content="Invert" IsChecked="{Binding InvertHorizontalScroll}"/>
                    </Grid>
                    <TextBlock Text="{Binding HorizontalScrollSpeedMultiplier, StringFormat='Scroll speed: {0:F1}×'}" Style="{StaticResource DescriptionText}"/>
                    <Slider Minimum="0.5" Maximum="5.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                            Value="{Binding HorizontalScrollSpeedMultiplier}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Excluded Apps">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource DescriptionText}" Margin="0,0,0,4" TextWrapping="Wrap"
                               Text="Edge scrolling is off while one of these apps is in front."/>
                    <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AppPicker" Grid.Column="0" IsEditable="True"
                                  ToolTip="Pick a running app, or type a process name such as mstsc"
                                  DropDownOpened="OnAppPickerOpened"/>
                        <Button Grid.Column="1" Content="Add" Padding="10,2" Margin="6,0,0,0" Click="OnAddExcluded"/>
                        <Button Grid.Column="2" Content="Remove" Padding="10,2" Margin="6,0,0,0" Click="OnRemoveExcluded"/>
                    </Grid>
                    <ListBox x:Name="ExcludedList" ItemsSource="{Binding ExcludedApps}" MinHeight="72"/>
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
