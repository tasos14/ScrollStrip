<Window
    x:Class="ScrollStrip.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ScrollStrip Settings">

    <ScrollViewer x:Name="Root" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16" Spacing="8">

            <!-- General -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="General" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <ToggleSwitch Header="Edge scrolling"
                                  IsOn="{Binding EdgeScrollEnabled, Mode=TwoWay}"
                                  OnContent="" OffContent=""/>
                    <ToggleSwitch Header="Smooth scrolling (inertia)"
                                  IsOn="{Binding InertiaEnabled, Mode=TwoWay}"
                                  OnContent="" OffContent=""/>
                    <Slider Header="Inertia strength"
                            Minimum="1" Maximum="10" StepFrequency="1" TickFrequency="1"
                            SnapsTo="StepValues"
                            Value="{Binding InertiaStrength, Mode=TwoWay}"/>
                    <CheckBox Content="Lock cursor while scrolling"
                              IsChecked="{Binding LockCursorDuringScroll, Mode=TwoWay}"/>
                    <CheckBox Content="Run at Windows startup"
                              IsChecked="{Binding RunAtStartup, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- Right Edge -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal">
                        <Canvas Width="20" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="19" Height="15"
                                       Fill="#F5F5F5" Stroke="#A8A8A8" StrokeThickness="1.5"/>
                            <Rectangle Canvas.Left="15" Canvas.Top="2" Width="3" Height="11"
                                       Fill="#0078D4"/>
                        </Canvas>
                        <TextBlock Text="Right Edge — Vertical Scroll"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <ToggleSwitch Header="Enabled"
                                  IsOn="{Binding RightEdgeEnabled, Mode=TwoWay}"
                                  OnContent="" OffContent=""/>
                    <CheckBox Content="Invert scroll direction"
                              IsChecked="{Binding InvertVerticalScroll, Mode=TwoWay}"/>
                    <Slider Header="Edge width (%)"
                            Minimum="5" Maximum="30" StepFrequency="1" TickFrequency="5"
                            SnapsTo="StepValues"
                            Value="{Binding RightEdgeWidthPct, Mode=TwoWay}"/>
                    <Slider Header="Scroll speed"
                            Minimum="0.5" Maximum="5.0" StepFrequency="0.1" TickFrequency="0.5"
                            SnapsTo="StepValues"
                            Value="{Binding VerticalScrollSpeedMultiplier, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- Bottom Edge -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal">
                        <Canvas Width="20" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="19" Height="15"
                                       Fill="#F5F5F5" Stroke="#A8A8A8" StrokeThickness="1.5"/>
                            <Rectangle Canvas.Left="1" Canvas.Top="12" Width="17" Height="2"
                                       Fill="#0078D4"/>
                        </Canvas>
                        <TextBlock Text="Bottom Edge — Horizontal Scroll"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <ToggleSwitch Header="Enabled"
                                  IsOn="{Binding BottomEdgeEnabled, Mode=TwoWay}"
                                  OnContent="" OffContent=""/>
                    <CheckBox Content="Invert scroll direction"
                              IsChecked="{Binding InvertHorizontalScroll, Mode=TwoWay}"/>
                    <Slider Header="Edge height (%)"
                            Minimum="5" Maximum="30" StepFrequency="1" TickFrequency="5"
                            SnapsTo="StepValues"
                            Value="{Binding BottomEdgeHeightPct, Mode=TwoWay}"/>
                    <Slider Header="Scroll speed"
                            Minimum="0.5" Maximum="5.0" StepFrequency="0.1" TickFrequency="0.5"
                            SnapsTo="StepValues"
                            Value="{Binding HorizontalScrollSpeedMultiplier, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
