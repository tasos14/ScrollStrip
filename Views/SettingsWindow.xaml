<Window x:Class="ScrollStrip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScrollStrip Settings" SizeToContent="Height" Width="360"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,4,8,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="DescriptionText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>

        <!-- Touchpad icon: right edge highlighted -->
        <DrawingImage x:Key="IconRightEdge">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F5F5F5">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0.75,0.75,18.5,14.5" RadiusX="2.5" RadiusY="2.5"/>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#A8A8A8" Thickness="1.5"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#C8C8C8">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="15.5,1.75,3,11.5" RadiusX="1.5" RadiusY="1.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Touchpad icon: left edge highlighted -->
        <DrawingImage x:Key="IconLeftEdge">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F5F5F5">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0.75,0.75,18.5,14.5" RadiusX="2.5" RadiusY="2.5"/>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#A8A8A8" Thickness="1.5"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#C8C8C8">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="1.5,1.75,3,11.5" RadiusX="1.5" RadiusY="1.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Touchpad icon: bottom edge highlighted -->
        <DrawingImage x:Key="IconBottomEdge">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F5F5F5">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0.75,0.75,18.5,14.5" RadiusX="2.5" RadiusY="2.5"/>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#A8A8A8" Thickness="1.5"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#C8C8C8">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="1.75,11.75,16.5,2.5" RadiusX="1.5" RadiusY="1.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>

    <StackPanel Margin="12">
        <!-- Global -->
        <GroupBox Header="General">
            <StackPanel>
                <CheckBox Content="Enable edge scrolling" IsChecked="{Binding EdgeScrollEnabled}"/>
                <CheckBox Content="Smooth scrolling (inertia)" IsChecked="{Binding InertiaEnabled}"/>
                <TextBlock Text="{Binding InertiaStrength, StringFormat='Inertia strength: {0}/10'}" Style="{StaticResource DescriptionText}"/>
                <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding InertiaStrength}"/>
                <CheckBox Content="Lock cursor position while scrolling" IsChecked="{Binding LockCursorDuringScroll}"/>
                <CheckBox Content="Run at Windows startup" IsChecked="{Binding RunAtStartup}"/>
            </StackPanel>
        </GroupBox>

        <!-- Zone geometry and lifecycle, shared by every edge -->
        <GroupBox Header="Edge Zone">
            <StackPanel>
                <TextBlock Text="{Binding EdgeZoneWidthMm, StringFormat='Zone width: {0:F1} mm'}" Style="{StaticResource DescriptionText}"/>
                <Slider Minimum="1.5" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True"
                        Value="{Binding EdgeZoneWidthMm}"/>
                <CheckBox Content="Only scroll if the touch starts in the zone" IsChecked="{Binding RequireBeginInZone}"/>
                <CheckBox Content="Stop scrolling when the finger leaves the zone" IsChecked="{Binding StopWhenLeavingZone}"/>
                <TextBlock Style="{StaticResource DescriptionText}" TextWrapping="Wrap"
                           Text="Touchpads that don't report their physical size use a percentage of the pad instead (10% by default)."/>
            </StackPanel>
        </GroupBox>

        <!-- Vertical (left and right edges) -->
        <GroupBox>
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource IconLeftEdge}" Width="20" Height="16" Margin="0,0,2,0" VerticalAlignment="Center"/>
                    <Image Source="{StaticResource IconRightEdge}" Width="20" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Side Edges — Vertical Scroll" Foreground="Black" FontSize="12" Margin="0" VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox.Header>
            <StackPanel>
                <CheckBox Content="Right edge" IsChecked="{Binding RightEdgeEnabled}"/>
                <CheckBox Content="Left edge" IsChecked="{Binding LeftEdgeEnabled}"/>
                <CheckBox Content="Invert vertical scroll" IsChecked="{Binding InvertVerticalScroll}"/>
                <TextBlock Text="{Binding VerticalScrollSpeedMultiplier, StringFormat='Scroll speed: {0:F1}×'}" Style="{StaticResource DescriptionText}"/>
                <Slider Minimum="0.5" Maximum="5.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        Value="{Binding VerticalScrollSpeedMultiplier}"/>
            </StackPanel>
        </GroupBox>

        <!-- Horizontal (bottom edge) -->
        <GroupBox>
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource IconBottomEdge}" Width="20" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Bottom Edge — Horizontal Scroll" Foreground="Black" FontSize="12" Margin="0" VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox.Header>
            <StackPanel>
                <CheckBox Content="Enabled" IsChecked="{Binding BottomEdgeEnabled}"/>
                <CheckBox Content="Invert horizontal scroll" IsChecked="{Binding InvertHorizontalScroll}"/>
                <TextBlock Text="{Binding HorizontalScrollSpeedMultiplier, StringFormat='Scroll speed: {0:F1}×'}" Style="{StaticResource DescriptionText}"/>
                <Slider Minimum="0.5" Maximum="5.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        Value="{Binding HorizontalScrollSpeedMultiplier}"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</Window>
